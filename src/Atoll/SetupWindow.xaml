<Window
    x:Class="Atoll.SetupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Island colors whatever the system theme: black surfaces, white text, the icon's teal as accent. -->
    <Grid x:Name="Root" RequestedTheme="Dark" Background="#0B0B0E">
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.ThemeDictionaries>
                    <ResourceDictionary x:Key="Dark">
                        <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#36CDBB" />
                        <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#E636CDBB" />
                        <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#CC36CDBB" />
                        <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#08080A" />
                        <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#36CDBB" />
                        <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#4FD8C8" />
                        <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#2BB3A3" />
                        <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#08080A" />
                        <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#08080A" />
                        <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#08080A" />
                        <SolidColorBrush x:Key="AccentButtonBackground" Color="#36CDBB" />
                        <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#4FD8C8" />
                        <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#2BB3A3" />
                        <SolidColorBrush x:Key="AccentButtonForeground" Color="#08080A" />
                        <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#08080A" />
                        <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#08080A" />
                        <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStroke" Color="#36CDBB" />
                        <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStrokePointerOver" Color="#4FD8C8" />
                        <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStrokePressed" Color="#2BB3A3" />
                        <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFill" Color="#36CDBB" />
                        <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFillPointerOver" Color="#4FD8C8" />
                        <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFillPressed" Color="#2BB3A3" />
                        <SolidColorBrush x:Key="RadioButtonCheckGlyphFill" Color="#08080A" />
                        <SolidColorBrush x:Key="RadioButtonCheckGlyphFillPointerOver" Color="#08080A" />
                        <SolidColorBrush x:Key="RadioButtonCheckGlyphFillPressed" Color="#08080A" />
                    </ResourceDictionary>
                </ResourceDictionary.ThemeDictionaries>
                <SolidColorBrush x:Key="Card" Color="#141418" />
                <SolidColorBrush x:Key="Raised" Color="#1C1C21" />
                <SolidColorBrush x:Key="Muted" Color="#9B9BA5" />
                <SolidColorBrush x:Key="Accent" Color="#36CDBB" />
            </ResourceDictionary>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title bar: the window draws its own, with the island mark -->
        <Grid x:Name="TitleBar" Padding="18,0,0,0" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Grid Width="26" Height="13">
                    <Border CornerRadius="6.5" Background="#08080A" BorderBrush="#EBEBF0" BorderThickness="1" />
                    <Ellipse Width="5" Height="5" Fill="{StaticResource Accent}" HorizontalAlignment="Right" Margin="0,0,4,0" />
                </Grid>
                <TextBlock x:Name="WindowTitle" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="Nav" Width="196" Padding="12,4,8,12" Spacing="2" />
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="Page" Padding="20,4,32,24" Spacing="12" MaxWidth="600" HorizontalAlignment="Left" />
            </ScrollViewer>
        </Grid>

        <Grid Grid.Row="2" Padding="24,14,24,18" BorderBrush="{StaticResource Raised}" BorderThickness="0,1,0,0">
            <StackPanel x:Name="Dots" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button x:Name="BackButton" Content="Back" Click="Back_Click" MinWidth="88" />
                <Button x:Name="NextButton" Content="Next" Style="{StaticResource AccentButtonStyle}" Click="Next_Click" MinWidth="88" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
