<Window
    x:Class="Atoll.IslandWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="Transparent">
        <Grid.Resources>
            <FontFamily x:Key="Icons">Segoe Fluent Icons,Segoe MDL2 Assets</FontFamily>
            <FontFamily x:Key="Mono">Cascadia Mono,Consolas</FontFamily>
            <SolidColorBrush x:Key="Fg" Color="#F4F4F6" />
            <SolidColorBrush x:Key="Muted" Color="#9B9BA5" />
            <SolidColorBrush x:Key="Line" Color="#2C2C33" />
            <SolidColorBrush x:Key="Raised" Color="#1C1C21" />
            <Style x:Key="Chip" TargetType="Border">
                <Setter Property="Background" Value="#1C1C21" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="11,5" />
            </Style>
            <Style x:Key="ChipText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="10.5" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="#F4F4F6" />
            </Style>
        </Grid.Resources>

        <!-- The island. Its black shape is drawn by the compositor (Render), so resizing it every frame
             costs no layout, and the same shape clips the layers. Hit-testing is limited to the shape by
             the window region. -->
        <Grid x:Name="Pill" Background="Transparent"
              PointerEntered="Pill_PointerEntered" PointerExited="Pill_PointerExited" Tapped="Pill_Tapped"
              AllowDrop="True" DragEnter="Pill_DragEnter" DragOver="Pill_DragOver" DragLeave="Pill_DragLeave" Drop="Pill_Drop">
            <Border x:Name="ShapeHost" />
            <!-- The split bubble's countdown: placed by Render beside the pill, outside the clipped layers -->
            <TextBlock x:Name="BubbleText" Width="32" Height="32" Padding="0,9,0,0" TextAlignment="Center" FontFamily="{StaticResource Mono}" FontSize="9.5"
                       Foreground="#FFB454" HorizontalAlignment="Left" VerticalAlignment="Top" Opacity="0" IsHitTestVisible="False" />
            <Grid x:Name="Layers" Margin="0,8,0,0">
                <!-- Compact pill: artwork left, waveform right -->
                <Grid x:Name="CompactLayer" Width="214" Height="32" Padding="8,0,12,0" Opacity="0"
                      HorizontalAlignment="Center" VerticalAlignment="Top" RenderTransformOrigin="0.5,0">
                    <Grid.RenderTransform>
                        <ScaleTransform ScaleX="0.94" ScaleY="0.94" />
                    </Grid.RenderTransform>
                    <Grid x:Name="CompactMedia">
                        <Border x:Name="CompactArt" Width="22" Height="22" CornerRadius="6" Background="{StaticResource Line}" HorizontalAlignment="Left">
                            <FontIcon x:Name="CompactArtIcon" Glyph="&#xEC4F;" FontSize="12" FontFamily="{StaticResource Icons}" Foreground="{StaticResource Fg}" />
                        </Border>
                        <StackPanel x:Name="Wave" Orientation="Horizontal" Spacing="2" Height="16" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Rectangle Width="3" Height="16" RadiusX="1.5" RadiusY="1.5" Fill="White" />
                            <Rectangle Width="3" Height="16" RadiusX="1.5" RadiusY="1.5" Fill="White" />
                            <Rectangle Width="3" Height="16" RadiusX="1.5" RadiusY="1.5" Fill="White" />
                            <Rectangle Width="3" Height="16" RadiusX="1.5" RadiusY="1.5" Fill="White" />
                        </StackPanel>
                    </Grid>
                    <!-- A timer alone: its countdown -->
                    <Grid x:Name="CompactTimer" Visibility="Collapsed">
                        <FontIcon Glyph="&#xE916;" FontSize="14" FontFamily="{StaticResource Icons}" Foreground="#FFB454" HorizontalAlignment="Left" />
                        <TextBlock x:Name="CompactTimerText" FontFamily="{StaticResource Mono}" FontSize="12" Foreground="#FFB454" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                </Grid>

                <!-- Alert: icon, two lines or a level bar, optional action -->
                <Grid x:Name="AlertLayer" Width="304" Height="50" Padding="8,0,10,0" ColumnSpacing="10" Opacity="0"
                      HorizontalAlignment="Center" VerticalAlignment="Top" RenderTransformOrigin="0.5,0">
                    <Grid.RenderTransform>
                        <ScaleTransform ScaleX="0.94" ScaleY="0.94" />
                    </Grid.RenderTransform>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="AlertIconFrame" Width="34" Height="34" CornerRadius="17" Background="#1C1C21" VerticalAlignment="Center">
                        <FontIcon x:Name="AlertIcon" FontSize="17" FontFamily="{StaticResource Icons}" Foreground="{StaticResource Fg}" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="AlertTitle" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Fg}" TextTrimming="CharacterEllipsis" MaxLines="1" />
                        <TextBlock x:Name="AlertSub" FontSize="10.5" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" MaxLines="1" />
                        <Grid x:Name="AlertBar" Height="5" Margin="0,5,0,0">
                            <Border CornerRadius="2.5" Background="{StaticResource Line}" />
                            <!-- Scaled rather than resized, so it can fill up smoothly (charging) -->
                            <Border x:Name="AlertBarFill" CornerRadius="2.5" Background="White" RenderTransformOrigin="0,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="AlertBarScale" ScaleX="0" />
                                </Border.RenderTransform>
                            </Border>
                        </Grid>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                        <StackPanel x:Name="AlertWave" Orientation="Horizontal" Spacing="2" Height="16" VerticalAlignment="Center" Margin="0,0,6,0">
                            <Rectangle Width="3" Height="16" RadiusX="1.5" RadiusY="1.5" Fill="White" />
                            <Rectangle Width="3" Height="16" RadiusX="1.5" RadiusY="1.5" Fill="White" />
                            <Rectangle Width="3" Height="16" RadiusX="1.5" RadiusY="1.5" Fill="White" />
                            <Rectangle Width="3" Height="16" RadiusX="1.5" RadiusY="1.5" Fill="White" />
                        </StackPanel>
                        <Border x:Name="AlertAction2" Style="{StaticResource Chip}" Tapped="AlertAction2_Tapped">
                            <TextBlock x:Name="AlertAction2Text" Style="{StaticResource ChipText}" />
                        </Border>
                        <Border x:Name="AlertAction" Background="White" CornerRadius="12" Padding="11,5" Tapped="AlertAction_Tapped">
                            <TextBlock x:Name="AlertActionText" FontSize="10.5" FontWeight="SemiBold" Foreground="#08080A" />
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Game music card: shortcut during a game set to "Only when I ask" -->
                <Grid x:Name="GameLayer" Width="288" Height="66" Padding="11,0,8,0" ColumnSpacing="10" Opacity="0"
                      HorizontalAlignment="Center" VerticalAlignment="Top" RenderTransformOrigin="0.5,0">
                    <Grid.RenderTransform>
                        <ScaleTransform ScaleX="0.94" ScaleY="0.94" />
                    </Grid.RenderTransform>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="GameArtColumn" Width="45" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="GameArt" Height="45" CornerRadius="11" Background="{StaticResource Line}">
                        <FontIcon x:Name="GameArtIcon" Glyph="&#xEC4F;" FontSize="18" FontFamily="{StaticResource Icons}" Foreground="{StaticResource Fg}" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="GameTitle" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Fg}" TextTrimming="CharacterEllipsis" MaxLines="1" />
                        <TextBlock x:Name="GameArtist" FontSize="10.5" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" MaxLines="1" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid Width="32" Height="32" CornerRadius="16" Background="Transparent" Tapped="Previous_Tapped"
                              PointerEntered="Button_PointerEntered" PointerExited="Button_PointerExited">
                            <FontIcon Glyph="&#xE892;" FontSize="14" FontFamily="{StaticResource Icons}" Foreground="{StaticResource Fg}" />
                        </Grid>
                        <Grid Width="32" Height="32" CornerRadius="16" Background="Transparent" Tapped="Play_Tapped"
                              PointerEntered="Button_PointerEntered" PointerExited="Button_PointerExited">
                            <FontIcon x:Name="GamePlayIcon" Glyph="&#xE768;" FontSize="17" FontFamily="{StaticResource Icons}" Foreground="{StaticResource Fg}" />
                        </Grid>
                        <Grid Width="32" Height="32" CornerRadius="16" Background="Transparent" Tapped="Next_Tapped"
                              PointerEntered="Button_PointerEntered" PointerExited="Button_PointerExited">
                            <FontIcon Glyph="&#xE893;" FontSize="14" FontFamily="{StaticResource Icons}" Foreground="{StaticResource Fg}" />
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- Expanded panel: tabs on top, one pane below. Media fits 170 high, the others 190. -->
                <Grid x:Name="ExpandedLayer" Width="430" Height="190" Padding="14,11,14,13" Opacity="0"
                      HorizontalAlignment="Center" VerticalAlignment="Top" RenderTransformOrigin="0.5,0">
                    <Grid.RenderTransform>
                        <ScaleTransform ScaleX="0.94" ScaleY="0.94" />
                    </Grid.RenderTransform>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="22" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0">
                        <!-- Microphone (orange) and camera (green) in use, while it lasts -->
                        <StackPanel x:Name="PrivacyDots" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center" />
                        <TextBlock x:Name="SourceBadge" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel x:Name="Tabs" Orientation="Horizontal" Spacing="3">
                        <Grid Tag="Media" CornerRadius="11" Padding="9,0" Tapped="Tab_Tapped">
                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xEC4F;" FontSize="12" FontFamily="{StaticResource Icons}" />
                                <TextBlock Text="Media" FontSize="10.5" FontWeight="SemiBold" />
                            </StackPanel>
                        </Grid>
                        <Grid Tag="Timers" CornerRadius="11" Padding="9,0" Tapped="Tab_Tapped">
                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE916;" FontSize="12" FontFamily="{StaticResource Icons}" />
                                <TextBlock Text="Timers" FontSize="10.5" FontWeight="SemiBold" />
                            </StackPanel>
                        </Grid>
                        <Grid Tag="Shelf" CornerRadius="11" Padding="9,0" Tapped="Tab_Tapped">
                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE7B8;" FontSize="12" FontFamily="{StaticResource Icons}" />
                                <TextBlock x:Name="ShelfTabText" Text="Shelf" FontSize="10.5" FontWeight="SemiBold" />
                            </StackPanel>
                        </Grid>
                        <Grid Tag="Clipboard" CornerRadius="11" Padding="9,0" Tapped="Tab_Tapped">
                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE77F;" FontSize="12" FontFamily="{StaticResource Icons}" />
                                <TextBlock Text="Clipboard" FontSize="10.5" FontWeight="SemiBold" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <!-- Media -->
                        <Grid x:Name="MediaTab">
                            <TextBlock x:Name="NothingPlaying" Text="Nothing playing right now" Foreground="{StaticResource Muted}" FontSize="11"
                                       HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0" />
                            <Grid x:Name="MediaPane" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="58" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid ColumnSpacing="11">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition x:Name="ArtColumn" Width="58" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="ExpandedArt" CornerRadius="11" Background="{StaticResource Line}">
                                        <FontIcon x:Name="ExpandedArtIcon" Glyph="&#xEC4F;" FontSize="22" FontFamily="{StaticResource Icons}" Foreground="{StaticResource Fg}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="TitleText" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Fg}" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                        <TextBlock x:Name="ArtistText" FontSize="11" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                        <Grid x:Name="ProgressRow" Margin="0,6,0,0" ColumnSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="PositionText" FontFamily="{StaticResource Mono}" FontSize="10" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                                            <Grid x:Name="SeekTrack" Grid.Column="1" Height="14" Background="Transparent" Tapped="Seek_Tapped">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition x:Name="SeekDone" Width="0*" />
                                                    <ColumnDefinition x:Name="SeekLeft" Width="1*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.ColumnSpan="2" Height="5" CornerRadius="2.5" Background="{StaticResource Line}" />
                                                <Border Height="5" CornerRadius="2.5" Background="White" />
                                            </Grid>
                                            <TextBlock x:Name="DurationText" Grid.Column="2" FontFamily="{StaticResource Mono}" FontSize="10" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                                <StackPanel x:Name="PanelWave" Grid.Row="1" Margin="0,4,6,0" Orientation="Horizontal" Spacing="2" Height="16" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Rectangle Width="3" Height="16" RadiusX="1.5" RadiusY="1.5" Fill="White" />
                                    <Rectangle Width="3" Height="16" RadiusX="1.5" RadiusY="1.5" Fill="White" />
                                    <Rectangle Width="3" Height="16" RadiusX="1.5" RadiusY="1.5" Fill="White" />
                                    <Rectangle Width="3" Height="16" RadiusX="1.5" RadiusY="1.5" Fill="White" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Margin="0,4,0,0" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                    <Grid Width="36" Height="36" CornerRadius="18" Background="Transparent" Tapped="Previous_Tapped"
                                          PointerEntered="Button_PointerEntered" PointerExited="Button_PointerExited">
                                        <FontIcon Glyph="&#xE892;" FontSize="16" FontFamily="{StaticResource Icons}" Foreground="{StaticResource Fg}" />
                                    </Grid>
                                    <Grid Width="36" Height="36" CornerRadius="18" Background="Transparent" Tapped="Play_Tapped"
                                          PointerEntered="Button_PointerEntered" PointerExited="Button_PointerExited">
                                        <FontIcon x:Name="PlayIcon" Glyph="&#xE768;" FontSize="19" FontFamily="{StaticResource Icons}" Foreground="{StaticResource Fg}" />
                                    </Grid>
                                    <Grid Width="36" Height="36" CornerRadius="18" Background="Transparent" Tapped="Next_Tapped"
                                          PointerEntered="Button_PointerEntered" PointerExited="Button_PointerExited">
                                        <FontIcon Glyph="&#xE893;" FontSize="16" FontFamily="{StaticResource Icons}" Foreground="{StaticResource Fg}" />
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <!-- Timers -->
                        <StackPanel x:Name="TimersTab" Visibility="Collapsed" Spacing="10">
                            <StackPanel x:Name="TimerIdle" Spacing="10">
                                <TextBlock Text="Start a timer. It counts down while you work." Foreground="{StaticResource Muted}" FontSize="11" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Border Style="{StaticResource Chip}" Tag="60" Tapped="TimerStart_Tapped"><TextBlock Text="1 min" Style="{StaticResource ChipText}" /></Border>
                                    <Border Style="{StaticResource Chip}" Tag="300" Tapped="TimerStart_Tapped"><TextBlock Text="5 min" Style="{StaticResource ChipText}" /></Border>
                                    <Border Style="{StaticResource Chip}" Tag="1500" Tapped="TimerStart_Tapped"><TextBlock Text="25 min focus" Style="{StaticResource ChipText}" /></Border>
                                </StackPanel>
                            </StackPanel>
                            <Grid x:Name="TimerRunning" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock x:Name="TimerLabel" Foreground="{StaticResource Muted}" FontSize="11" />
                                    <TextBlock x:Name="TimerLeft" FontFamily="{StaticResource Mono}" FontSize="30" Foreground="#FFB454" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Border Style="{StaticResource Chip}" Tapped="TimerAdd_Tapped"><TextBlock Text="+1 min" Style="{StaticResource ChipText}" /></Border>
                                    <Border Style="{StaticResource Chip}" Tapped="TimerCancel_Tapped"><TextBlock Text="Cancel" Style="{StaticResource ChipText}" /></Border>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <!-- Shelf: files dropped here stay until removed, and drag out into any app -->
                        <StackPanel x:Name="ShelfTab" Visibility="Collapsed" Spacing="5" />

                        <!-- Clipboard -->
                        <StackPanel x:Name="ClipboardTab" Visibility="Collapsed" Spacing="5" />
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
