<Window
    x:Class="Atoll.IslandWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="Transparent" AllowFocusOnInteraction="False" IsTabStop="False">
        <Border x:Name="Pill" Background="#08080A" HorizontalAlignment="Center" VerticalAlignment="Top">
            <Border.RenderTransform>
                <TranslateTransform x:Name="PillOffset" />
            </Border.RenderTransform>
            <Grid x:Name="PanelContent" Opacity="0" Padding="18,14" RenderTransformOrigin="0.5,0">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="ContentScale" ScaleX="0.94" ScaleY="0.94" />
                </Grid.RenderTransform>
                <TextBlock Text="Nothing playing right now" Foreground="#9B9BA5" FontSize="13"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
