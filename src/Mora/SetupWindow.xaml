<Window
    x:Class="Mora.SetupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- macOS System Settings in dark: a dark window, a sidebar of colored icons, grouped boxes, Apple's blue as accent. -->
    <Grid x:Name="Root" RequestedTheme="Dark" Background="#1E1E1E">
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.ThemeDictionaries>
                    <ResourceDictionary x:Key="Dark">
                        <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#0A84FF" />
                        <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#E60A84FF" />
                        <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#CC0A84FF" />
                        <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFF" />
                        <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#0A84FF" />
                        <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#3D9BFF" />
                        <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#0670DD" />
                        <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FFFFFF" />
                        <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#FFFFFF" />
                        <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#FFFFFF" />
                        <SolidColorBrush x:Key="AccentButtonBackground" Color="#0A84FF" />
                        <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#3D9BFF" />
                        <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#0670DD" />
                        <SolidColorBrush x:Key="AccentButtonForeground" Color="#FFFFFF" />
                        <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#FFFFFF" />
                        <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#FFFFFF" />
                        <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStroke" Color="#0A84FF" />
                        <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStrokePointerOver" Color="#3D9BFF" />
                        <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStrokePressed" Color="#0670DD" />
                        <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFill" Color="#0A84FF" />
                        <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFillPointerOver" Color="#3D9BFF" />
                        <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFillPressed" Color="#0670DD" />
                        <SolidColorBrush x:Key="RadioButtonCheckGlyphFill" Color="#FFFFFF" />
                        <SolidColorBrush x:Key="RadioButtonCheckGlyphFillPointerOver" Color="#FFFFFF" />
                        <SolidColorBrush x:Key="RadioButtonCheckGlyphFillPressed" Color="#FFFFFF" />
                        <SolidColorBrush x:Key="HyperlinkButtonForeground" Color="#0A84FF" />
                        <SolidColorBrush x:Key="HyperlinkButtonForegroundPointerOver" Color="#3D9BFF" />
                        <SolidColorBrush x:Key="HyperlinkButtonForegroundPressed" Color="#0670DD" />
                    </ResourceDictionary>
                </ResourceDictionary.ThemeDictionaries>
                <SolidColorBrush x:Key="Card" Color="#2A2A2C" />
                <SolidColorBrush x:Key="Raised" Color="#1AFFFFFF" />
                <SolidColorBrush x:Key="Muted" Color="#98989D" />
                <SolidColorBrush x:Key="Sidebar" Color="#252527" />
                <SolidColorBrush x:Key="Accent" Color="#0A84FF" />
            </ResourceDictionary>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title bar: the window draws its own, with the island mark -->
        <Grid x:Name="TitleBar" Padding="18,0,0,0" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Grid Width="26" Height="13">
                    <Border CornerRadius="6.5" Background="#08080A" BorderBrush="#EBEBF0" BorderThickness="1" />
                    <Ellipse Width="5" Height="5" Fill="{StaticResource Accent}" HorizontalAlignment="Right" Margin="0,0,4,0" />
                </Grid>
                <TextBlock x:Name="WindowTitle" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Background="{StaticResource Sidebar}" BorderBrush="{StaticResource Raised}" BorderThickness="0,0,1,0"><StackPanel x:Name="Nav" Width="200" Padding="10,8,10,12" Spacing="2" /></Border>
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="Page" Padding="28,8,32,28" Spacing="10" MaxWidth="620" HorizontalAlignment="Left" />
            </ScrollViewer>
        </Grid>

        <Grid Grid.Row="2" Padding="24,14,24,18" BorderBrush="{StaticResource Raised}" BorderThickness="0,1,0,0">
            <StackPanel x:Name="Dots" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button x:Name="BackButton" Content="Back" Click="Back_Click" MinWidth="88" />
                <Button x:Name="NextButton" Content="Next" Style="{StaticResource AccentButtonStyle}" Click="Next_Click" MinWidth="88" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
