<Window
    x:Class="Mora.SetupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark and monochrome: a near-black wash behind, a sidebar of outline icons, the pages on a rounded sheet a shade lighter, white as the accent. -->
    <Grid x:Name="Root" RequestedTheme="Dark"><Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#1A1D1F" Offset="0" /><GradientStop Color="#121314" Offset="0.55" /><GradientStop Color="#0E0E0F" Offset="1" /></LinearGradientBrush></Grid.Background>
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.ThemeDictionaries>
                    <ResourceDictionary x:Key="Dark">
                        <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#F2F2F7" />
                        <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#E6F2F2F7" />
                        <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#CCF2F2F7" />
                        <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#000000" />
                        <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#F2F2F7" />
                        <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#FFFFFF" />
                        <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#D1D1D6" />
                        <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#000000" />
                        <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#000000" />
                        <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#000000" />
                        <SolidColorBrush x:Key="AccentButtonBackground" Color="#F2F2F7" />
                        <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#FFFFFF" />
                        <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#D1D1D6" />
                        <SolidColorBrush x:Key="AccentButtonForeground" Color="#000000" />
                        <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#000000" />
                        <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#000000" />
                        <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStroke" Color="#F2F2F7" />
                        <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStrokePointerOver" Color="#FFFFFF" />
                        <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStrokePressed" Color="#D1D1D6" />
                        <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFill" Color="#F2F2F7" />
                        <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFillPointerOver" Color="#FFFFFF" />
                        <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFillPressed" Color="#D1D1D6" />
                        <SolidColorBrush x:Key="RadioButtonCheckGlyphFill" Color="#000000" />
                        <SolidColorBrush x:Key="RadioButtonCheckGlyphFillPointerOver" Color="#000000" />
                        <SolidColorBrush x:Key="RadioButtonCheckGlyphFillPressed" Color="#000000" />
                        <SolidColorBrush x:Key="HyperlinkButtonForeground" Color="#F2F2F7" />
                        <SolidColorBrush x:Key="HyperlinkButtonForegroundPointerOver" Color="#FFFFFF" />
                        <SolidColorBrush x:Key="HyperlinkButtonForegroundPressed" Color="#D1D1D6" />
                    </ResourceDictionary>
                </ResourceDictionary.ThemeDictionaries>
                <SolidColorBrush x:Key="Card" Color="#232325" />
                <SolidColorBrush x:Key="Raised" Color="#2F2F32" />
                <SolidColorBrush x:Key="Muted" Color="#8E8E93" />
                <SolidColorBrush x:Key="Sheet" Color="#1A1A1C" />
                <SolidColorBrush x:Key="Accent" Color="#F2F2F7" />
            </ResourceDictionary>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title bar: the window draws its own, with the island mark -->
        <Grid x:Name="TitleBar" Padding="18,0,0,0" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <ContentPresenter x:Name="TitleMark" VerticalAlignment="Center" />
                <TextBlock x:Name="WindowTitle" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="Nav" Width="212" Padding="14,6,14,12" Spacing="3" />
            <Border Grid.Column="1" Background="{StaticResource Sheet}" BorderBrush="{StaticResource Raised}" BorderThickness="1" CornerRadius="18" Margin="0,0,12,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="Page" Padding="28,8,32,28" Spacing="10" MaxWidth="620" HorizontalAlignment="Left" />
            </ScrollViewer>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Padding="24,12,24,14">
            <StackPanel x:Name="Dots" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button x:Name="BackButton" Content="Back" Click="Back_Click" MinWidth="88" />
                <Button x:Name="NextButton" Content="Next" Style="{StaticResource AccentButtonStyle}" Click="Next_Click" MinWidth="88" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
