<Window
    x:Class="Mora.IslandWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="Transparent">
        <Grid.Resources>
            <FontFamily x:Key="Icons">Segoe Fluent Icons,Segoe MDL2 Assets</FontFamily>
            <FontFamily x:Key="Mono">Cascadia Mono,Consolas</FontFamily>
            <SolidColorBrush x:Key="Fg" Color="#F4F4F6" />
            <SolidColorBrush x:Key="Muted" Color="#9B9BA5" />
            <SolidColorBrush x:Key="Line" Color="#2C2C33" />
            <SolidColorBrush x:Key="Raised" Color="#1C1C21" />
            <!-- Strong marks (waveform, progress, main button) and the text on them. Colors set by the theme. -->
            <SolidColorBrush x:Key="Ink" Color="White" />
            <SolidColorBrush x:Key="InkText" Color="#08080A" />
            <FontFamily x:Key="Text">Segoe UI Variable Text,Segoe UI</FontFamily>
            <FontFamily x:Key="Display">Segoe UI Variable Display,Segoe UI</FontFamily>
            <!-- Widgets: a card a step above the black, with a hairline edge, like macOS widgets on a dark desktop -->
            <SolidColorBrush x:Key="Card" Color="#141416" />
            <SolidColorBrush x:Key="CardLine" Color="#1AFFFFFF" />
            <Style x:Key="Widget" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource Card}" />
                <Setter Property="BorderBrush" Value="{StaticResource CardLine}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="20" />
                <Setter Property="Padding" Value="13,11" />
            </Style>
            <!-- Capsule buttons, Apple's: a soft gray fill, the label firm -->
            <Style x:Key="Capsule" TargetType="Border">
                <Setter Property="Background" Value="#2C2C2E" />
                <Setter Property="CornerRadius" Value="15" />
                <Setter Property="Padding" Value="14,7" />
            </Style>
            <Style x:Key="CapsuleText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource Text}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource Fg}" />
            </Style>
            <!-- Small caps labels, Apple's way of naming a widget or a section -->
            <Style x:Key="Caps" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource Text}" />
                <Setter Property="FontSize" Value="10" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="60" />
                <Setter Property="Foreground" Value="{StaticResource Muted}" />
            </Style>
            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource Text}" />
            </Style>
            <Style x:Key="Chip" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource Raised}" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="11,5" />
            </Style>
            <Style x:Key="ChipText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource Text}" />
                <Setter Property="FontSize" Value="10.5" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource Fg}" />
            </Style>
        </Grid.Resources>

        <!-- The island. Its black shape is drawn by the compositor (Render), so resizing it every frame
             costs no layout, and the same shape clips the layers. Hit-testing is limited to the shape by
             the window region. -->
        <Grid x:Name="Pill" Background="Transparent"
              PointerEntered="Pill_PointerEntered" PointerExited="Pill_PointerExited" Tapped="Pill_Tapped"
              AllowDrop="True" DragEnter="Pill_DragEnter" DragOver="Pill_DragOver" DragLeave="Pill_DragLeave" Drop="Pill_Drop">
            <Border x:Name="ShapeHost" />
            <!-- The split bubble's countdown: placed by Render beside the pill, outside the clipped layers -->
            <Grid x:Name="BubbleHost" Width="32" Height="32" HorizontalAlignment="Left" VerticalAlignment="Top" Opacity="0" IsHitTestVisible="False">
                <TextBlock x:Name="BubbleText" Padding="0,9,0,0" TextAlignment="Center" FontFamily="{StaticResource Mono}" FontSize="9.5" Foreground="#FFB454" />
                <!-- Beside the open panel, the time: a small clock face over the time and the day -->
                <StackPanel x:Name="ClockFace" VerticalAlignment="Center" Spacing="10" Visibility="Collapsed">
                    <Grid Width="38" Height="38" HorizontalAlignment="Center">
                        <Ellipse Fill="{StaticResource Raised}" Stroke="{StaticResource Line}" StrokeThickness="1" />
                        <Canvas x:Name="ClockTicks" />
                        <Rectangle Width="2.6" Height="10" Margin="0,9,0,0" RadiusX="1.3" RadiusY="1.3" Fill="{StaticResource Fg}" HorizontalAlignment="Center" VerticalAlignment="Top" RenderTransformOrigin="0.5,1">
                            <Rectangle.RenderTransform><RotateTransform x:Name="HourHand" /></Rectangle.RenderTransform>
                        </Rectangle>
                        <Rectangle Width="1.8" Height="14" Margin="0,5,0,0" RadiusX="0.9" RadiusY="0.9" Fill="{StaticResource Fg}" HorizontalAlignment="Center" VerticalAlignment="Top" RenderTransformOrigin="0.5,1">
                            <Rectangle.RenderTransform><RotateTransform x:Name="MinuteHand" /></Rectangle.RenderTransform>
                        </Rectangle>
                        <Rectangle Width="1" Height="16" Margin="0,3,0,0" Fill="#FF9F0A" HorizontalAlignment="Center" VerticalAlignment="Top" RenderTransformOrigin="0.5,1">
                            <Rectangle.RenderTransform><RotateTransform x:Name="SecondHand" /></Rectangle.RenderTransform>
                        </Rectangle>
                        <Ellipse Width="4" Height="4" Fill="#FF9F0A" />
                    </Grid>
                    <StackPanel Spacing="1">
                        <TextBlock x:Name="FaceTime" FontFamily="Segoe UI Variable Display,Segoe UI" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Fg}" HorizontalAlignment="Center" />
                        <TextBlock x:Name="FaceDay" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Grid>
            <Grid x:Name="Layers">
                <!-- Compact pill: artwork left, waveform right -->
                <Grid x:Name="CompactLayer" Width="214" Height="32" Padding="8,0,12,0" Opacity="0"
                      HorizontalAlignment="Center" VerticalAlignment="Top" RenderTransformOrigin="0.5,0">
                    <Grid.RenderTransform>
                        <ScaleTransform ScaleX="0.94" ScaleY="0.94" />
                    </Grid.RenderTransform>
                    <Grid x:Name="CompactMedia">
                        <Border x:Name="CompactArt" Width="22" Height="22" CornerRadius="6" Background="{StaticResource Line}" HorizontalAlignment="Left">
                            <FontIcon x:Name="CompactArtIcon" Glyph="&#xEC4F;" FontSize="12" FontFamily="{StaticResource Icons}" Foreground="{StaticResource Fg}" />
                        </Border>
                        <StackPanel x:Name="Wave" Orientation="Horizontal" Spacing="2" Height="16" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Rectangle Width="3" Height="16" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource Ink}" />
                            <Rectangle Width="3" Height="16" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource Ink}" />
                            <Rectangle Width="3" Height="16" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource Ink}" />
                            <Rectangle Width="3" Height="16" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource Ink}" />
                        </StackPanel>
                    </Grid>
                    <!-- A coding agent at work: its logo in the ring of its progress, the project, how it goes -->
                    <Grid x:Name="CompactAgent" Visibility="Collapsed" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ContentPresenter x:Name="CompactAgentBadge" VerticalAlignment="Center" />
                        <TextBlock x:Name="CompactAgentName" Grid.Column="1" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Fg}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxLines="1" />
                        <TextBlock x:Name="CompactAgentState" Grid.Column="2" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </Grid>
                    <!-- A timer alone: its countdown -->
                    <Grid x:Name="CompactTimer" Visibility="Collapsed">
                        <FontIcon x:Name="CompactTimerIcon" Glyph="&#xE916;" FontSize="14" FontFamily="{StaticResource Icons}" Foreground="#FFB454" HorizontalAlignment="Left" />
                        <TextBlock x:Name="CompactTimerText" FontFamily="{StaticResource Mono}" FontSize="12" Foreground="#FFB454" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                </Grid>

                <!-- Alert: icon, two lines or a level bar, optional action -->
                <Grid x:Name="AlertLayer" Width="304" Height="50" Padding="8,0,10,0" ColumnSpacing="10" Opacity="0"
                      HorizontalAlignment="Center" VerticalAlignment="Top" RenderTransformOrigin="0.5,0">
                    <Grid.RenderTransform>
                        <ScaleTransform ScaleX="0.94" ScaleY="0.94" />
                    </Grid.RenderTransform>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="AlertIconFrame" Width="34" Height="34" CornerRadius="17" Background="{StaticResource Raised}" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <CompositeTransform x:Name="AlertArtMove" />
                        </Border.RenderTransform>
                        <Grid>
                            <FontIcon x:Name="AlertIcon" FontSize="17" FontFamily="{StaticResource Icons}" Foreground="{StaticResource Fg}" />
                            <ContentPresenter x:Name="AlertMascot" />
                        </Grid>
                    </Border>
                    <StackPanel x:Name="AlertText" Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel.RenderTransform>
                            <TranslateTransform x:Name="AlertTextMove" />
                        </StackPanel.RenderTransform>
                        <TextBlock x:Name="AlertTitle" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Fg}" TextTrimming="CharacterEllipsis" MaxLines="1" />
                        <TextBlock x:Name="AlertSub" FontSize="10.5" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" MaxLines="1" />
                        <Grid x:Name="AlertBar" Height="5" Margin="0,5,0,0">
                            <Border x:Name="AlertBarTrack" CornerRadius="2.5" Background="{StaticResource Line}" />
                            <!-- Scaled rather than resized, so it can fill up smoothly (charging) -->
                            <Border x:Name="AlertBarFill" CornerRadius="2.5" Background="{StaticResource Ink}" RenderTransformOrigin="0,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="AlertBarScale" ScaleX="0" />
                                </Border.RenderTransform>
                            </Border>
                        </Grid>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                        <StackPanel x:Name="AlertWave" Orientation="Horizontal" Spacing="2" Height="16" VerticalAlignment="Center" Margin="0,0,6,0">
                            <Rectangle Width="3" Height="16" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource Ink}" />
                            <Rectangle Width="3" Height="16" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource Ink}" />
                            <Rectangle Width="3" Height="16" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource Ink}" />
                            <Rectangle Width="3" Height="16" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource Ink}" />
                        </StackPanel>
                        <Border x:Name="AlertAction2" Style="{StaticResource Chip}" Tapped="AlertAction2_Tapped">
                            <TextBlock x:Name="AlertAction2Text" Style="{StaticResource ChipText}" />
                        </Border>
                        <Border x:Name="AlertAction" Background="{StaticResource Ink}" CornerRadius="12" Padding="11,5" Tapped="AlertAction_Tapped">
                            <TextBlock x:Name="AlertActionText" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource InkText}" />
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Game music card: shortcut during a game set to "Only when I ask" -->
                <Grid x:Name="GameLayer" Width="288" Height="66" Padding="11,0,8,0" ColumnSpacing="10" Opacity="0"
                      HorizontalAlignment="Center" VerticalAlignment="Top" RenderTransformOrigin="0.5,0">
                    <Grid.RenderTransform>
                        <ScaleTransform ScaleX="0.94" ScaleY="0.94" />
                    </Grid.RenderTransform>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="GameArtColumn" Width="45" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="GameArt" Height="45" CornerRadius="11" Background="{StaticResource Line}">
                        <FontIcon x:Name="GameArtIcon" Glyph="&#xEC4F;" FontSize="18" FontFamily="{StaticResource Icons}" Foreground="{StaticResource Fg}" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="GameTitle" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Fg}" TextTrimming="CharacterEllipsis" MaxLines="1" />
                        <TextBlock x:Name="GameArtist" FontSize="10.5" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" MaxLines="1" />
                        <TextBlock x:Name="GameClock" FontSize="10" FontFamily="{StaticResource Mono}" Foreground="{StaticResource Muted}" Margin="0,2,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid Width="32" Height="32" CornerRadius="16" Background="Transparent" Tapped="Previous_Tapped" PointerPressed="Press_Down" PointerReleased="Press_Up" PointerCaptureLost="Press_Up" PointerCanceled="Press_Up"
                              PointerEntered="Button_PointerEntered" PointerExited="Button_PointerExited">
                            <FontIcon Glyph="&#xE892;" FontSize="14" FontFamily="{StaticResource Icons}" Foreground="{StaticResource Fg}" />
                        </Grid>
                        <Grid Width="32" Height="32" CornerRadius="16" Background="Transparent" Tapped="Play_Tapped" PointerPressed="Press_Down" PointerReleased="Press_Up" PointerCaptureLost="Press_Up" PointerCanceled="Press_Up"
                              PointerEntered="Button_PointerEntered" PointerExited="Button_PointerExited">
                            <FontIcon x:Name="GamePlayIcon" Glyph="&#xE768;" FontSize="17" FontFamily="{StaticResource Icons}" Foreground="{StaticResource Fg}" />
                        </Grid>
                        <Grid Width="32" Height="32" CornerRadius="16" Background="Transparent" Tapped="Next_Tapped" PointerPressed="Press_Down" PointerReleased="Press_Up" PointerCaptureLost="Press_Up" PointerCanceled="Press_Up"
                              PointerEntered="Button_PointerEntered" PointerExited="Button_PointerExited">
                            <FontIcon Glyph="&#xE893;" FontSize="14" FontFamily="{StaticResource Icons}" Foreground="{StaticResource Fg}" />
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- The open island, after Apple's: one page at a time straight on the black, no boxes. Dots at the bottom
                     (or the mouse wheel) turn the pages; the time, the moon and the gear sit quietly on the same line. -->
                <Grid x:Name="ExpandedLayer" Width="680" Height="170" Padding="24,16,24,8" Opacity="0"
                      HorizontalAlignment="Center" VerticalAlignment="Top" RenderTransformOrigin="0.5,0" Background="Transparent"
                      PointerWheelChanged="Panel_PointerWheelChanged">
                    <Grid.RenderTransform>
                        <ScaleTransform ScaleX="0.94" ScaleY="0.94" />
                    </Grid.RenderTransform>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="22" />
                    </Grid.RowDefinitions>

                    <!-- The crab's lane: along the bottom line, between the page icons and the moon, never in the way of a click -->
                    <Canvas x:Name="MascotLane" Grid.Row="1" Height="17" Width="118" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,66,0" IsHitTestVisible="False" Visibility="Collapsed" />

                    <!-- The bottom line: the time and the privacy dots, the page dots, Do not disturb and Settings -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <TextBlock x:Name="PanelClock" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Visibility="Collapsed" />
                        <StackPanel x:Name="PrivacyDots" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel x:Name="Tabs" Grid.Row="1" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid Tag="Media" Width="34" Height="24" CornerRadius="12" RenderTransformOrigin="0.5,0.5" Background="Transparent" Tapped="Tab_Tapped" PointerPressed="Press_Down" PointerReleased="Press_Up" PointerCaptureLost="Press_Up" PointerCanceled="Press_Up"><ToolTipService.ToolTip>Now playing</ToolTipService.ToolTip><FontIcon Glyph="&#xEC4F;" FontSize="13" FontFamily="{StaticResource Icons}" /></Grid>
                        <Grid Tag="Home" Width="34" Height="24" CornerRadius="12" RenderTransformOrigin="0.5,0.5" Background="Transparent" Tapped="Tab_Tapped" PointerPressed="Press_Down" PointerReleased="Press_Up" PointerCaptureLost="Press_Up" PointerCanceled="Press_Up"><ToolTipService.ToolTip>Today</ToolTipService.ToolTip><FontIcon Glyph="&#xE787;" FontSize="13" FontFamily="{StaticResource Icons}" /></Grid>
                        <Grid Tag="Timers" Width="34" Height="24" CornerRadius="12" RenderTransformOrigin="0.5,0.5" Background="Transparent" Tapped="Tab_Tapped" PointerPressed="Press_Down" PointerReleased="Press_Up" PointerCaptureLost="Press_Up" PointerCanceled="Press_Up"><ToolTipService.ToolTip>Timers</ToolTipService.ToolTip><FontIcon Glyph="&#xE916;" FontSize="13" FontFamily="{StaticResource Icons}" /></Grid>
                        <Grid x:Name="AgentsTabButton" Tag="Agents" Width="34" Height="24" CornerRadius="12" RenderTransformOrigin="0.5,0.5" Background="Transparent" Tapped="Tab_Tapped" PointerPressed="Press_Down" PointerReleased="Press_Up" PointerCaptureLost="Press_Up" PointerCanceled="Press_Up" Visibility="Collapsed"><ToolTipService.ToolTip>Agents</ToolTipService.ToolTip><FontIcon Glyph="&#xE99A;" FontSize="13" FontFamily="{StaticResource Icons}" /></Grid>
                        <Grid Tag="Shelf" Width="34" Height="24" CornerRadius="12" RenderTransformOrigin="0.5,0.5" Background="Transparent" Tapped="Tab_Tapped" PointerPressed="Press_Down" PointerReleased="Press_Up" PointerCaptureLost="Press_Up" PointerCanceled="Press_Up"><ToolTipService.ToolTip><TextBlock x:Name="ShelfTabText" Text="Shelf" /></ToolTipService.ToolTip><FontIcon Glyph="&#xE7B8;" FontSize="13" FontFamily="{StaticResource Icons}" /></Grid>
                        <Grid Tag="Clipboard" Width="34" Height="24" CornerRadius="12" RenderTransformOrigin="0.5,0.5" Background="Transparent" Tapped="Tab_Tapped" PointerPressed="Press_Down" PointerReleased="Press_Up" PointerCaptureLost="Press_Up" PointerCanceled="Press_Up"><ToolTipService.ToolTip>Clipboard</ToolTipService.ToolTip><FontIcon Glyph="&#xE77F;" FontSize="13" FontFamily="{StaticResource Icons}" /></Grid>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="2" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-6,0">
                        <Grid Width="24" Height="22" CornerRadius="11" Background="Transparent" Tapped="Quiet_Tapped" PointerPressed="Press_Down" PointerReleased="Press_Up" PointerCaptureLost="Press_Up" PointerCanceled="Press_Up" PointerEntered="Button_PointerEntered" PointerExited="Button_PointerExited">
                            <ToolTipService.ToolTip>Do not disturb</ToolTipService.ToolTip>
                            <FontIcon x:Name="QuietIcon" Glyph="&#xE708;" FontSize="11" FontFamily="{StaticResource Icons}" Foreground="{StaticResource Muted}" />
                        </Grid>
                        <Grid Width="24" Height="22" CornerRadius="11" Background="Transparent" Tapped="Settings_Tapped" PointerPressed="Press_Down" PointerReleased="Press_Up" PointerCaptureLost="Press_Up" PointerCanceled="Press_Up" PointerEntered="Button_PointerEntered" PointerExited="Button_PointerExited">
                            <ToolTipService.ToolTip>Settings</ToolTipService.ToolTip>
                            <FontIcon Glyph="&#xE713;" FontSize="11" FontFamily="{StaticResource Icons}" Foreground="{StaticResource Muted}" />
                        </Grid>
                    </StackPanel>

                    <Grid>
                        <!-- Now playing, as the Dynamic Island shows it: the cover, the title, a waveform in the cover's color,
                             a full-width scrubber and large solid controls -->
                        <Grid x:Name="MediaTab">
                            <StackPanel x:Name="NothingPlaying" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xEC4F;" FontSize="22" FontFamily="{StaticResource Icons}" Foreground="{StaticResource Muted}" />
                                <TextBlock Text="Not playing" FontSize="13" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" />
                            </StackPanel>
                            <Grid x:Name="MediaPane" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="ArtColumn" Width="88" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="ExpandedArt" Height="88" CornerRadius="18" Background="{StaticResource Line}" VerticalAlignment="Center">
                                    <FontIcon x:Name="ExpandedArtIcon" Glyph="&#xEC4F;" FontSize="26" FontFamily="{StaticResource Icons}" Foreground="{StaticResource Fg}" />
                                </Border>
                                <Grid Grid.Column="1" VerticalAlignment="Center" Margin="20,0,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock x:Name="TitleText" FontFamily="{StaticResource Display}" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource Fg}" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                            <TextBlock x:Name="ArtistText" FontSize="14" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="6" HorizontalAlignment="Right">
                                            <!-- The player followed; with several open, a tap switches to the next -->
                                            <Border x:Name="SourceButton" CornerRadius="8" Padding="6,1" HorizontalAlignment="Right" Background="Transparent" Tapped="Source_Tapped"
                                                    PointerEntered="Source_PointerEntered" PointerExited="Source_PointerExited">
                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                    <TextBlock x:Name="SourceBadge" Style="{StaticResource Caps}" />
                                                    <FontIcon x:Name="SourceSwitch" Glyph="&#xE8AB;" FontSize="9" FontFamily="{StaticResource Icons}" Foreground="{StaticResource Muted}" Visibility="Collapsed" />
                                                </StackPanel>
                                            </Border>
                                            <StackPanel x:Name="PanelWave" Orientation="Horizontal" Spacing="2.5" Height="18" HorizontalAlignment="Right" Margin="0,0,6,0">
                                                <Rectangle Width="3" Height="18" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource Ink}" />
                                                <Rectangle Width="3" Height="18" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource Ink}" />
                                                <Rectangle Width="3" Height="18" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource Ink}" />
                                                <Rectangle Width="3" Height="18" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource Ink}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                    <Grid x:Name="ProgressRow" Grid.Row="1" Margin="0,12,0,0" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="34" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="PositionText" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                                        <Grid x:Name="SeekTrack" Grid.Column="1" Height="16" Background="Transparent" Tapped="Seek_Tapped">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition x:Name="SeekDone" Width="0*" />
                                                <ColumnDefinition x:Name="SeekLeft" Width="1*" />
                                            </Grid.ColumnDefinitions>
                                            <Border x:Name="SeekBack" Grid.ColumnSpan="2" Height="4" CornerRadius="2" Background="#3A3A3C" />
                                            <Border x:Name="SeekFill" Height="4" CornerRadius="2" Background="{StaticResource Ink}" />
                                        </Grid>
                                        <TextBlock x:Name="DurationText" Grid.Column="2" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                    </Grid>
                                    <Grid Grid.Row="2" Margin="0,6,0,0">
                                        <Grid x:Name="LyricsButton" Width="30" Height="30" CornerRadius="15" Background="Transparent" HorizontalAlignment="Left" VerticalAlignment="Center"
                                              Tapped="Lyrics_Tapped" PointerPressed="Press_Down" PointerReleased="Press_Up" PointerCaptureLost="Press_Up" PointerCanceled="Press_Up">
                                            <ToolTipService.ToolTip>Synced lyrics</ToolTipService.ToolTip>
                                            <FontIcon x:Name="LyricsIcon" Glyph="&#xE8BD;" FontSize="13" FontFamily="{StaticResource Icons}" Foreground="{StaticResource Muted}" />
                                        </Grid>
                                        <!-- Solid controls, drawn: back, play or pause, forward -->
                                        <StackPanel Orientation="Horizontal" Spacing="26" HorizontalAlignment="Center">
                                            <Grid Width="44" Height="36" CornerRadius="18" Background="Transparent" Tapped="Previous_Tapped" PointerPressed="Press_Down" PointerReleased="Press_Up" PointerCaptureLost="Press_Up" PointerCanceled="Press_Up" PointerEntered="Button_PointerEntered" PointerExited="Button_PointerExited">
                                                <Path Fill="{StaticResource Fg}" Width="26" Height="15" Stretch="Uniform" Data="M 13,1.2 C 13,0.3 12,-0.3 11.2,0.2 L 0.8,6.7 C 0.1,7.2 0.1,8.2 0.8,8.7 L 11.2,15.2 C 12,15.7 13,15.1 13,14.2 Z M 26,1.2 C 26,0.3 25,-0.3 24.2,0.2 L 13.8,6.7 C 13.1,7.2 13.1,8.2 13.8,8.7 L 24.2,15.2 C 25,15.7 26,15.1 26,14.2 Z" />
                                            </Grid>
                                            <Grid Width="44" Height="36" CornerRadius="18" Background="Transparent" Tapped="Play_Tapped" PointerPressed="Press_Down" PointerReleased="Press_Up" PointerCaptureLost="Press_Up" PointerCanceled="Press_Up" PointerEntered="Button_PointerEntered" PointerExited="Button_PointerExited">
                                                <FontIcon x:Name="PlayIcon" Glyph="&#xE768;" Visibility="Collapsed" FontFamily="{StaticResource Icons}" />
                                                <Path x:Name="PlayShape" Fill="{StaticResource Fg}" Width="19" Height="22" Stretch="Uniform" Margin="3,0,0,0" Data="M 0,1.6 C 0,0.4 1.3,-0.4 2.3,0.2 L 18.2,9.6 C 19.2,10.2 19.2,11.8 18.2,12.4 L 2.3,21.8 C 1.3,22.4 0,21.6 0,20.4 Z" />
                                                <Path x:Name="PauseShape" Fill="{StaticResource Fg}" Width="17" Height="21" Stretch="Uniform" Visibility="Collapsed" Data="M 1.6,0 H 5 C 5.9,0 6.6,0.7 6.6,1.6 V 19.4 C 6.6,20.3 5.9,21 5,21 H 1.6 C 0.7,21 0,20.3 0,19.4 V 1.6 C 0,0.7 0.7,0 1.6,0 Z M 12,0 H 15.4 C 16.3,0 17,0.7 17,1.6 V 19.4 C 17,20.3 16.3,21 15.4,21 H 12 C 11.1,21 10.4,20.3 10.4,19.4 V 1.6 C 10.4,0.7 11.1,0 12,0 Z" />
                                            </Grid>
                                            <Grid Width="44" Height="36" CornerRadius="18" Background="Transparent" Tapped="Next_Tapped" PointerPressed="Press_Down" PointerReleased="Press_Up" PointerCaptureLost="Press_Up" PointerCanceled="Press_Up" PointerEntered="Button_PointerEntered" PointerExited="Button_PointerExited">
                                                <Path Fill="{StaticResource Fg}" Width="26" Height="15" Stretch="Uniform" Data="M 0,1.2 C 0,0.3 1,-0.3 1.8,0.2 L 12.2,6.7 C 12.9,7.2 12.9,8.2 12.2,8.7 L 1.8,15.2 C 1,15.7 0,15.1 0,14.2 Z M 13,1.2 C 13,0.3 14,-0.3 14.8,0.2 L 25.2,6.7 C 25.9,7.2 25.9,8.2 25.2,8.7 L 14.8,15.2 C 14,15.7 13,15.1 13,14.2 Z" />
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                                <!-- Synced lyrics, beside: the line being sung, and the next one, past a hairline -->
                                <Grid x:Name="LyricsCard" Grid.Column="2" Width="230" Margin="20,0,0,0" Visibility="Collapsed">
                                    <Rectangle Width="1" Fill="#2C2C2E" HorizontalAlignment="Left" Margin="0,8" />
                                    <StackPanel VerticalAlignment="Center" Spacing="6" Margin="20,0,0,0">
                                        <TextBlock x:Name="LyricNow" FontFamily="{StaticResource Display}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Fg}" TextWrapping="WrapWholeWords" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="LyricNext" FontSize="13" Foreground="{StaticResource Muted}" TextWrapping="WrapWholeWords" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Grid>

                        <!-- Today, like the Lock Screen's widgets: the date, focus and the weather, side by side on the black,
                             a hairline between them -->
                        <Grid x:Name="HomeTab" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.3*" />
                                <ColumnDefinition Width="1" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>
                            <Grid ColumnSpacing="16" Margin="0,0,20,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,0,16"> <!-- as tall as the weather beside it (its high and low line): the labels and the large numbers line up -->
                                    <TextBlock x:Name="HomeWeekday" Style="{StaticResource Caps}" FontSize="11" Foreground="#FF453A" />
                                    <TextBlock x:Name="HomeDay" FontFamily="{StaticResource Display}" FontSize="44" FontWeight="Light" Foreground="{StaticResource Fg}" Margin="-2,-6,0,0" />
                                </StackPanel>
                                <StackPanel x:Name="HomeEvents" Grid.Column="1" Spacing="10" VerticalAlignment="Center" />
                            </Grid>
                            <Rectangle Grid.Column="1" Fill="#2C2C2E" Margin="0,10" />
                            <!-- Focus: a ring like the Clock app's timer; a tap starts or stops it -->
                            <Grid Grid.Column="2" Background="Transparent" Tapped="HomeTimer_Tapped" PointerPressed="Press_Down" PointerReleased="Press_Up" PointerCaptureLost="Press_Up" PointerCanceled="Press_Up" ColumnSpacing="14" HorizontalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="74" Height="74" VerticalAlignment="Center">
                                    <Ellipse Stroke="#2C2C2E" StrokeThickness="6" />
                                    <Ellipse x:Name="HomeTimerArc" StrokeThickness="6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform><RotateTransform Angle="-90" /></Ellipse.RenderTransform>
                                    </Ellipse>
                                    <FontIcon x:Name="HomeTimerIcon" Glyph="&#xE768;" FontSize="18" FontFamily="{StaticResource Icons}" Foreground="{StaticResource Fg}" />
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                    <TextBlock x:Name="HomeTimerLabel" Style="{StaticResource Caps}" FontSize="11" />
                                    <TextBlock x:Name="HomeTimerLeft" FontFamily="{StaticResource Display}" FontSize="24" FontWeight="Light" Foreground="{StaticResource Fg}" />
                                </StackPanel>
                            </Grid>
                            <Rectangle Grid.Column="3" Fill="#2C2C2E" Margin="0,10" />
                            <!-- Weather, like Apple's: the sky, the temperature large and light, the day's high and low -->
                            <Grid Grid.Column="4" Margin="22,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="HomeWeatherNone" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                <StackPanel x:Name="HomeWeather" Spacing="0">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon x:Name="HomeSky" FontSize="12" FontFamily="{StaticResource Icons}" Foreground="{StaticResource Muted}" />
                                        <TextBlock x:Name="HomeSkyText" Style="{StaticResource Caps}" FontSize="11" />
                                    </StackPanel>
                                    <TextBlock x:Name="HomeTemp" FontFamily="{StaticResource Display}" FontSize="44" FontWeight="Light" Foreground="{StaticResource Fg}" Margin="-2,-6,0,-4" />
                                    <TextBlock x:Name="HomeHighLow" FontSize="12" Foreground="{StaticResource Muted}" />
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <!-- Timers, like the Clock app: durations in capsules; running, a ring that empties around the countdown -->
                        <Grid x:Name="TimersTab" Visibility="Collapsed">
                            <Grid x:Name="TimerIdle" ColumnSpacing="26" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Timer" FontFamily="{StaticResource Display}" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource Fg}" />
                                    <TextBlock Text="Pick a length, or focus in rounds" FontSize="13" Foreground="{StaticResource Muted}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Border Style="{StaticResource Capsule}" Tag="60" Tapped="TimerStart_Tapped" PointerPressed="Press_Down" PointerReleased="Press_Up" PointerCaptureLost="Press_Up" PointerCanceled="Press_Up"><TextBlock Text="1 min" Style="{StaticResource CapsuleText}" /></Border>
                                    <Border Style="{StaticResource Capsule}" Tag="300" Tapped="TimerStart_Tapped" PointerPressed="Press_Down" PointerReleased="Press_Up" PointerCaptureLost="Press_Up" PointerCanceled="Press_Up"><TextBlock Text="5 min" Style="{StaticResource CapsuleText}" /></Border>
                                    <Border Style="{StaticResource Capsule}" Tag="900" Tapped="TimerStart_Tapped" PointerPressed="Press_Down" PointerReleased="Press_Up" PointerCaptureLost="Press_Up" PointerCanceled="Press_Up"><TextBlock Text="15 min" Style="{StaticResource CapsuleText}" /></Border>
                                    <Border Style="{StaticResource Capsule}" Background="#33FF9F0A" Tapped="FocusStart_Tapped" PointerPressed="Press_Down" PointerReleased="Press_Up" PointerCaptureLost="Press_Up" PointerCanceled="Press_Up"><TextBlock Text="Focus" Style="{StaticResource CapsuleText}" Foreground="#FF9F0A" /></Border>
                                </StackPanel>
                            </Grid>
                            <Grid x:Name="TimerRunning" Visibility="Collapsed" ColumnSpacing="26" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="112" Height="112">
                                    <Ellipse Stroke="#2C2C2E" StrokeThickness="7" />
                                    <Ellipse x:Name="TimerArc" StrokeThickness="7" Stroke="#FF9F0A" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform><RotateTransform Angle="-90" /></Ellipse.RenderTransform>
                                    </Ellipse>
                                    <TextBlock x:Name="TimerLeft" FontFamily="{StaticResource Display}" FontSize="26" FontWeight="Light" Foreground="{StaticResource Fg}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="14">
                                    <TextBlock x:Name="TimerLabel" FontFamily="{StaticResource Display}" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource Fg}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Style="{StaticResource Capsule}" Tapped="TimerAdd_Tapped" PointerPressed="Press_Down" PointerReleased="Press_Up" PointerCaptureLost="Press_Up" PointerCanceled="Press_Up"><TextBlock Text="+1 min" Style="{StaticResource CapsuleText}" /></Border>
                                        <Border Style="{StaticResource Capsule}" Background="#33FF453A" Tapped="TimerCancel_Tapped" PointerPressed="Press_Down" PointerReleased="Press_Up" PointerCaptureLost="Press_Up" PointerCanceled="Press_Up"><TextBlock Text="Cancel" Style="{StaticResource CapsuleText}" Foreground="#FF453A" /></Border>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <!-- Shelf: files dropped here stay until removed, and drag out into any app -->
                        <StackPanel x:Name="ShelfTab" Visibility="Collapsed" />

                        <!-- Clipboard -->
                        <StackPanel x:Name="ClipboardTab" Visibility="Collapsed" />

                        <!-- Coding agents, like the Batteries widget: a ring per session, the logo inside, its progress below -->
                        <StackPanel x:Name="AgentsTab" Visibility="Collapsed" />
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
