<Window
    x:Class="Mora.IslandWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="Transparent">
        <Grid.Resources>
            <FontFamily x:Key="Icons">Segoe Fluent Icons,Segoe MDL2 Assets</FontFamily>
            <FontFamily x:Key="Mono">Cascadia Mono,Consolas</FontFamily>
            <SolidColorBrush x:Key="Fg" Color="#F4F4F6" />
            <SolidColorBrush x:Key="Muted" Color="#9B9BA5" />
            <SolidColorBrush x:Key="Line" Color="#2C2C33" />
            <SolidColorBrush x:Key="Raised" Color="#1C1C21" />
            <!-- Strong marks (waveform, progress, main button) and the text on them. Colors set by the theme. -->
            <SolidColorBrush x:Key="Ink" Color="White" />
            <SolidColorBrush x:Key="InkText" Color="#08080A" />
            <FontFamily x:Key="Text">Segoe UI Variable Text,Segoe UI</FontFamily>
            <FontFamily x:Key="Display">Segoe UI Variable Display,Segoe UI</FontFamily>
            <!-- Widgets: a card a step above the black, with a hairline edge, like macOS widgets on a dark desktop -->
            <SolidColorBrush x:Key="Card" Color="#141416" />
            <SolidColorBrush x:Key="CardLine" Color="#1AFFFFFF" />
            <Style x:Key="Widget" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource Card}" />
                <Setter Property="BorderBrush" Value="{StaticResource CardLine}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="20" />
                <Setter Property="Padding" Value="13,11" />
            </Style>
            <!-- Capsule buttons, Apple's: a soft gray fill, the label firm -->
            <Style x:Key="Capsule" TargetType="Border">
                <Setter Property="Background" Value="#2C2C2E" />
                <Setter Property="CornerRadius" Value="15" />
                <Setter Property="Padding" Value="14,7" />
            </Style>
            <Style x:Key="CapsuleText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource Text}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource Fg}" />
            </Style>
            <!-- Small caps labels, Apple's way of naming a widget or a section -->
            <Style x:Key="Caps" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource Text}" />
                <Setter Property="FontSize" Value="10" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="60" />
                <Setter Property="Foreground" Value="{StaticResource Muted}" />
            </Style>
            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource Text}" />
            </Style>
            <Style x:Key="Chip" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource Raised}" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="11,5" />
            </Style>
            <Style x:Key="ChipText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource Text}" />
                <Setter Property="FontSize" Value="10.5" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource Fg}" />
            </Style>
        </Grid.Resources>

        <!-- The island. Its black shape is drawn by the compositor (Render), so resizing it every frame
             costs no layout, and the same shape clips the layers. Hit-testing is limited to the shape by
             the window region. -->
        <Grid x:Name="Pill" Background="Transparent"
              PointerEntered="Pill_PointerEntered" PointerExited="Pill_PointerExited" Tapped="Pill_Tapped"
              AllowDrop="True" DragEnter="Pill_DragEnter" DragOver="Pill_DragOver" DragLeave="Pill_DragLeave" Drop="Pill_Drop">
            <Border x:Name="ShapeHost" />
            <!-- The split bubble's countdown: placed by Render beside the pill, outside the clipped layers -->
            <Grid x:Name="BubbleHost" Width="32" Height="32" HorizontalAlignment="Left" VerticalAlignment="Top" Opacity="0" IsHitTestVisible="False">
                <TextBlock x:Name="BubbleText" Padding="0,9,0,0" TextAlignment="Center" FontFamily="{StaticResource Mono}" FontSize="9.5" Foreground="#FFB454" />
                <!-- Beside the open panel, the time: a small clock face over the time and the day -->
                <StackPanel x:Name="ClockFace" VerticalAlignment="Center" Spacing="10" Visibility="Collapsed">
                    <Grid Width="38" Height="38" HorizontalAlignment="Center">
                        <Ellipse Fill="{StaticResource Raised}" Stroke="{StaticResource Line}" StrokeThickness="1" />
                        <Canvas x:Name="ClockTicks" />
                        <Rectangle Width="2.6" Height="10" Margin="0,9,0,0" RadiusX="1.3" RadiusY="1.3" Fill="{StaticResource Fg}" HorizontalAlignment="Center" VerticalAlignment="Top" RenderTransformOrigin="0.5,1">
                            <Rectangle.RenderTransform><RotateTransform x:Name="HourHand" /></Rectangle.RenderTransform>
                        </Rectangle>
                        <Rectangle Width="1.8" Height="14" Margin="0,5,0,0" RadiusX="0.9" RadiusY="0.9" Fill="{StaticResource Fg}" HorizontalAlignment="Center" VerticalAlignment="Top" RenderTransformOrigin="0.5,1">
                            <Rectangle.RenderTransform><RotateTransform x:Name="MinuteHand" /></Rectangle.RenderTransform>
                        </Rectangle>
                        <Rectangle Width="1" Height="16" Margin="0,3,0,0" Fill="#FF9F0A" HorizontalAlignment="Center" VerticalAlignment="Top" RenderTransformOrigin="0.5,1">
                            <Rectangle.RenderTransform><RotateTransform x:Name="SecondHand" /></Rectangle.RenderTransform>
                        </Rectangle>
                        <Ellipse Width="4" Height="4" Fill="#FF9F0A" />
                    </Grid>
                    <StackPanel Spacing="1">
                        <TextBlock x:Name="FaceTime" FontFamily="Segoe UI Variable Display,Segoe UI" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Fg}" HorizontalAlignment="Center" />
                        <TextBlock x:Name="FaceDay" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Grid>
            <Grid x:Name="Layers">
                <!-- Compact pill: artwork left, waveform right -->
                <Grid x:Name="CompactLayer" Width="214" Height="32" Padding="8,0,12,0" Opacity="0"
                      HorizontalAlignment="Center" VerticalAlignment="Top" RenderTransformOrigin="0.5,0">
                    <Grid.RenderTransform>
                        <ScaleTransform ScaleX="0.94" ScaleY="0.94" />
                    </Grid.RenderTransform>
                    <Grid x:Name="CompactMedia">
                        <Border x:Name="CompactArt" Width="22" Height="22" CornerRadius="6" Background="{StaticResource Line}" HorizontalAlignment="Left">
                            <FontIcon x:Name="CompactArtIcon" Glyph="&#xEC4F;" FontSize="12" FontFamily="{StaticResource Icons}" Foreground="{StaticResource Fg}" />
                        </Border>
                        <StackPanel x:Name="Wave" Orientation="Horizontal" Spacing="2" Height="16" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Rectangle Width="3" Height="16" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource Ink}" />
                            <Rectangle Width="3" Height="16" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource Ink}" />
                            <Rectangle Width="3" Height="16" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource Ink}" />
                            <Rectangle Width="3" Height="16" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource Ink}" />
                        </StackPanel>
                    </Grid>
                    <!-- A coding agent at work: its logo in the ring of its progress, the project, how it goes -->
                    <Grid x:Name="CompactAgent" Visibility="Collapsed" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ContentPresenter x:Name="CompactAgentBadge" VerticalAlignment="Center" />
                        <TextBlock x:Name="CompactAgentName" Grid.Column="1" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Fg}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxLines="1" />
                        <TextBlock x:Name="CompactAgentState" Grid.Column="2" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </Grid>
                    <!-- A timer alone: its countdown -->
                    <Grid x:Name="CompactTimer" Visibility="Collapsed">
                        <FontIcon x:Name="CompactTimerIcon" Glyph="&#xE916;" FontSize="14" FontFamily="{StaticResource Icons}" Foreground="#FFB454" HorizontalAlignment="Left" />
                        <TextBlock x:Name="CompactTimerText" FontFamily="{StaticResource Mono}" FontSize="12" Foreground="#FFB454" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                </Grid>

                <!-- Alert: icon, two lines or a level bar, optional action -->
                <Grid x:Name="AlertLayer" Width="304" Height="50" Padding="8,0,10,0" ColumnSpacing="10" Opacity="0"
                      HorizontalAlignment="Center" VerticalAlignment="Top" RenderTransformOrigin="0.5,0">
                    <Grid.RenderTransform>
                        <ScaleTransform ScaleX="0.94" ScaleY="0.94" />
                    </Grid.RenderTransform>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="AlertIconFrame" Width="34" Height="34" CornerRadius="17" Background="{StaticResource Raised}" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <CompositeTransform x:Name="AlertArtMove" />
                        </Border.RenderTransform>
                        <Grid>
                            <FontIcon x:Name="AlertIcon" FontSize="17" FontFamily="{StaticResource Icons}" Foreground="{StaticResource Fg}" />
                            <ContentPresenter x:Name="AlertMascot" />
                        </Grid>
                    </Border>
                    <StackPanel x:Name="AlertText" Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel.RenderTransform>
                            <TranslateTransform x:Name="AlertTextMove" />
                        </StackPanel.RenderTransform>
                        <TextBlock x:Name="AlertTitle" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Fg}" TextTrimming="CharacterEllipsis" MaxLines="1" />
                        <TextBlock x:Name="AlertSub" FontSize="10.5" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" MaxLines="1" />
                        <Grid x:Name="AlertBar" Height="5" Margin="0,5,0,0">
                            <Border x:Name="AlertBarTrack" CornerRadius="2.5" Background="{StaticResource Line}" />
                            <!-- Scaled rather than resized, so it can fill up smoothly (charging) -->
                            <Border x:Name="AlertBarFill" CornerRadius="2.5" Background="{StaticResource Ink}" RenderTransformOrigin="0,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="AlertBarScale" ScaleX="0" />
                                </Border.RenderTransform>
                            </Border>
                        </Grid>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                        <StackPanel x:Name="AlertWave" Orientation="Horizontal" Spacing="2" Height="16" VerticalAlignment="Center" Margin="0,0,6,0">
                            <Rectangle Width="3" Height="16" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource Ink}" />
                            <Rectangle Width="3" Height="16" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource Ink}" />
                            <Rectangle Width="3" Height="16" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource Ink}" />
                            <Rectangle Width="3" Height="16" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource Ink}" />
                        </StackPanel>
                        <Border x:Name="AlertAction2" Style="{StaticResource Chip}" Tapped="AlertAction2_Tapped">
                            <TextBlock x:Name="AlertAction2Text" Style="{StaticResource ChipText}" />
                        </Border>
                        <Border x:Name="AlertAction" Background="{StaticResource Ink}" CornerRadius="12" Padding="11,5" Tapped="AlertAction_Tapped">
                            <TextBlock x:Name="AlertActionText" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource InkText}" />
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Game music card: shortcut during a game set to "Only when I ask" -->
                <Grid x:Name="GameLayer" Width="288" Height="66" Padding="11,0,8,0" ColumnSpacing="10" Opacity="0"
                      HorizontalAlignment="Center" VerticalAlignment="Top" RenderTransformOrigin="0.5,0">
                    <Grid.RenderTransform>
                        <ScaleTransform ScaleX="0.94" ScaleY="0.94" />
                    </Grid.RenderTransform>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="GameArtColumn" Width="45" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="GameArt" Height="45" CornerRadius="11" Background="{StaticResource Line}">
                        <FontIcon x:Name="GameArtIcon" Glyph="&#xEC4F;" FontSize="18" FontFamily="{StaticResource Icons}" Foreground="{StaticResource Fg}" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="GameTitle" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Fg}" TextTrimming="CharacterEllipsis" MaxLines="1" />
                        <TextBlock x:Name="GameArtist" FontSize="10.5" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" MaxLines="1" />
                        <TextBlock x:Name="GameClock" FontSize="10" FontFamily="{StaticResource Mono}" Foreground="{StaticResource Muted}" Margin="0,2,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid Width="32" Height="32" CornerRadius="16" Background="Transparent" Tapped="Previous_Tapped"
                              PointerEntered="Button_PointerEntered" PointerExited="Button_PointerExited">
                            <FontIcon Glyph="&#xE892;" FontSize="14" FontFamily="{StaticResource Icons}" Foreground="{StaticResource Fg}" />
                        </Grid>
                        <Grid Width="32" Height="32" CornerRadius="16" Background="Transparent" Tapped="Play_Tapped"
                              PointerEntered="Button_PointerEntered" PointerExited="Button_PointerExited">
                            <FontIcon x:Name="GamePlayIcon" Glyph="&#xE768;" FontSize="17" FontFamily="{StaticResource Icons}" Foreground="{StaticResource Fg}" />
                        </Grid>
                        <Grid Width="32" Height="32" CornerRadius="16" Background="Transparent" Tapped="Next_Tapped"
                              PointerEntered="Button_PointerEntered" PointerExited="Button_PointerExited">
                            <FontIcon Glyph="&#xE893;" FontSize="14" FontFamily="{StaticResource Icons}" Foreground="{StaticResource Fg}" />
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- Expanded panel: tabs on top, one pane below. Wide rather than tall: it covers less of the page under it. -->
                <Grid x:Name="ExpandedLayer" Width="680" Height="170" Padding="14,11,14,17" Opacity="0"
                      HorizontalAlignment="Center" VerticalAlignment="Top" RenderTransformOrigin="0.5,0">
                    <Grid.RenderTransform>
                        <ScaleTransform ScaleX="0.94" ScaleY="0.94" />
                    </Grid.RenderTransform>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="22" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0">
                        <!-- Microphone (orange) and camera (green) in use, while it lasts -->
                        <StackPanel x:Name="PrivacyDots" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center" />
                        <!-- Do not disturb: pop-ups wait, and show up as one summary when it is turned off -->
                        <Grid Width="22" Height="22" CornerRadius="11" Background="Transparent" VerticalAlignment="Center"
                              Tapped="Quiet_Tapped" PointerEntered="Button_PointerEntered" PointerExited="Button_PointerExited">
                            <ToolTipService.ToolTip>Do not disturb</ToolTipService.ToolTip>
                            <FontIcon x:Name="QuietIcon" Glyph="&#xE708;" FontSize="12" FontFamily="{StaticResource Icons}" Foreground="{StaticResource Muted}" />
                        </Grid>
                        <TextBlock x:Name="PanelClock" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Visibility="Collapsed" />
                        <!-- The player followed; with several open, a tap switches to the next -->
                        <Border x:Name="SourceButton" CornerRadius="9" Padding="7,2" VerticalAlignment="Center" Background="Transparent" Tapped="Source_Tapped"
                                PointerEntered="Source_PointerEntered" PointerExited="Source_PointerExited">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <TextBlock x:Name="SourceBadge" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Muted}" />
                                <FontIcon x:Name="SourceSwitch" Glyph="&#xE8AB;" FontSize="9" FontFamily="{StaticResource Icons}" Foreground="{StaticResource Muted}" Visibility="Collapsed" />
                            </StackPanel>
                        </Border>
                        <Grid Width="22" Height="22" CornerRadius="11" Background="Transparent" VerticalAlignment="Center"
                              Tapped="Settings_Tapped" PointerEntered="Button_PointerEntered" PointerExited="Button_PointerExited">
                            <ToolTipService.ToolTip>Settings</ToolTipService.ToolTip>
                            <FontIcon Glyph="&#xE713;" FontSize="12" FontFamily="{StaticResource Icons}" Foreground="{StaticResource Muted}" />
                        </Grid>
                    </StackPanel>
                    <!-- The crab's lane: the panel's bottom margin, under the content, never in the way of a click -->
                    <Canvas x:Name="MascotLane" Grid.Row="1" Height="17" VerticalAlignment="Bottom" Margin="0,0,0,-17" IsHitTestVisible="False" Visibility="Collapsed" />
                    <!-- The tabs: plain icons, the current one lit -->
                    <Border x:Name="TabsPill" HorizontalAlignment="Left" Margin="-4,0,0,0">
                    <StackPanel x:Name="Tabs" Orientation="Horizontal" Spacing="2">
                        <Grid Tag="Home" CornerRadius="9" Padding="8,0" Tapped="Tab_Tapped">
                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xF0E2;" FontSize="12" FontFamily="{StaticResource Icons}" />
                                <TextBlock Text="Home" FontSize="10.5" FontWeight="SemiBold" />
                            </StackPanel>
                        </Grid>
                        <Grid Tag="Media" CornerRadius="9" Padding="8,0" Tapped="Tab_Tapped">
                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xEC4F;" FontSize="12" FontFamily="{StaticResource Icons}" />
                                <TextBlock Text="Media" FontSize="10.5" FontWeight="SemiBold" />
                            </StackPanel>
                        </Grid>
                        <Grid Tag="Timers" CornerRadius="9" Padding="8,0" Tapped="Tab_Tapped">
                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE916;" FontSize="12" FontFamily="{StaticResource Icons}" />
                                <TextBlock Text="Timers" FontSize="10.5" FontWeight="SemiBold" />
                            </StackPanel>
                        </Grid>
                        <Grid Tag="Shelf" CornerRadius="9" Padding="8,0" Tapped="Tab_Tapped">
                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE7B8;" FontSize="12" FontFamily="{StaticResource Icons}" />
                                <TextBlock x:Name="ShelfTabText" Text="Shelf" FontSize="10.5" FontWeight="SemiBold" />
                            </StackPanel>
                        </Grid>
                        <Grid Tag="Clipboard" CornerRadius="9" Padding="8,0" Tapped="Tab_Tapped">
                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE77F;" FontSize="12" FontFamily="{StaticResource Icons}" />
                                <TextBlock Text="Clipboard" FontSize="10.5" FontWeight="SemiBold" />
                            </StackPanel>
                        </Grid>
                        <Grid x:Name="AgentsTabButton" Tag="Agents" CornerRadius="9" Padding="8,0" Tapped="Tab_Tapped" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE99A;" FontSize="12" FontFamily="{StaticResource Icons}" />
                                <TextBlock Text="Agents" FontSize="10.5" FontWeight="SemiBold" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                    </Border>

                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <!-- Home: four widgets, in the manner of macOS: music, the day's agenda, focus, weather -->
                        <Grid x:Name="HomeTab" Visibility="Collapsed" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.45*" />
                                <ColumnDefinition Width="1.35*" />
                                <ColumnDefinition Width="0.9*" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Widget}">
                                <Grid>
                                    <StackPanel x:Name="HomeNothing" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xEC4F;" FontSize="18" FontFamily="{StaticResource Icons}" Foreground="{StaticResource Muted}" />
                                        <TextBlock Text="Nothing playing" FontSize="11.5" Foreground="{StaticResource Muted}" />
                                    </StackPanel>
                                    <Grid x:Name="HomeMusic">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid ColumnSpacing="10" VerticalAlignment="Top">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition x:Name="HomeArtColumn" Width="46" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border x:Name="HomeArt" Height="46" CornerRadius="10" Background="{StaticResource Line}" VerticalAlignment="Center">
                                                <FontIcon x:Name="HomeArtIcon" Glyph="&#xEC4F;" FontSize="18" FontFamily="{StaticResource Icons}" Foreground="{StaticResource Fg}" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                <TextBlock x:Name="HomeTitle" FontFamily="{StaticResource Display}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Fg}" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                                <TextBlock x:Name="HomeArtist" FontSize="11" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                            </StackPanel>
                                        </Grid>
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10">
                                            <Grid Width="28" Height="28" CornerRadius="14" Background="Transparent" Tapped="Previous_Tapped" PointerEntered="Button_PointerEntered" PointerExited="Button_PointerExited">
                                                <FontIcon Glyph="&#xE892;" FontSize="12" FontFamily="{StaticResource Icons}" Foreground="{StaticResource Fg}" />
                                            </Grid>
                                            <Grid Width="30" Height="30" CornerRadius="15" Background="{StaticResource Ink}" Tapped="Play_Tapped">
                                                <FontIcon x:Name="HomePlayIcon" Glyph="&#xE768;" FontSize="12" FontFamily="{StaticResource Icons}" Foreground="{StaticResource InkText}" />
                                            </Grid>
                                            <Grid Width="28" Height="28" CornerRadius="14" Background="Transparent" Tapped="Next_Tapped" PointerEntered="Button_PointerEntered" PointerExited="Button_PointerExited">
                                                <FontIcon Glyph="&#xE893;" FontSize="12" FontFamily="{StaticResource Icons}" Foreground="{StaticResource Fg}" />
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                            <!-- The day like Apple's Calendar widget: the weekday in red, the date large, then what comes -->
                            <Border Grid.Column="1" Style="{StaticResource Widget}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock x:Name="HomeWeekday" Style="{StaticResource Caps}" Foreground="#FF453A" />
                                        <TextBlock x:Name="HomeDay" FontFamily="{StaticResource Display}" FontSize="32" FontWeight="Light" Foreground="{StaticResource Fg}" Margin="0,-3,0,0" />
                                    </StackPanel>
                                    <StackPanel x:Name="HomeEvents" Grid.Column="1" Spacing="7" VerticalAlignment="Top" Margin="0,2,0,0" />
                                </Grid>
                            </Border>
                            <!-- Focus: a ring like the Clock app's timer; the whole card starts or stops it -->
                            <Border Grid.Column="2" Style="{StaticResource Widget}" Tapped="HomeTimer_Tapped">
                                <Grid RowSpacing="6">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock x:Name="HomeTimerLabel" Style="{StaticResource Caps}" TextTrimming="CharacterEllipsis" />
                                    <Grid Grid.Row="1" Width="66" Height="66" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Ellipse Stroke="{StaticResource Line}" StrokeThickness="5" />
                                        <Ellipse x:Name="HomeTimerArc" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5">
                                            <Ellipse.RenderTransform><RotateTransform Angle="-90" /></Ellipse.RenderTransform>
                                        </Ellipse>
                                        <StackPanel VerticalAlignment="Center" Spacing="1">
                                            <TextBlock x:Name="HomeTimerLeft" FontFamily="{StaticResource Display}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                            <FontIcon x:Name="HomeTimerIcon" Glyph="&#xE768;" FontSize="9" FontFamily="{StaticResource Icons}" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                            <!-- Weather like Apple's: the temperature large and light, the sky, the day's high and low -->
                            <Border Grid.Column="3" Style="{StaticResource Widget}">
                                <Grid>
                                    <TextBlock x:Name="HomeWeatherNone" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Grid x:Name="HomeWeather">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock x:Name="HomeTemp" FontFamily="{StaticResource Display}" FontSize="34" FontWeight="Light" Foreground="{StaticResource Fg}" Margin="0,-6,0,0" />
                                        <FontIcon x:Name="HomeSky" FontSize="16" FontFamily="{StaticResource Icons}" Foreground="{StaticResource Fg}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,0,0" />
                                        <StackPanel Grid.Row="1" Spacing="1">
                                            <TextBlock x:Name="HomeSkyText" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Fg}" />
                                            <TextBlock x:Name="HomeHighLow" FontSize="11" Foreground="{StaticResource Muted}" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Media -->
                        <Grid x:Name="MediaTab">
                            <TextBlock x:Name="NothingPlaying" Text="Nothing playing right now" Foreground="{StaticResource Muted}" FontSize="11"
                                       HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0" />
                            <Grid x:Name="MediaPane" Visibility="Collapsed" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <!-- Synced lyrics, beside the player: the line being sung, and the next one -->
                                <Border x:Name="LyricsCard" Grid.Column="1" Width="250" Style="{StaticResource Widget}" Padding="16,0" Visibility="Collapsed">
                                    <StackPanel VerticalAlignment="Center" Spacing="4">
                                        <TextBlock x:Name="LyricNow" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Fg}" TextWrapping="WrapWholeWords" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="LyricNext" FontSize="11.5" Foreground="{StaticResource Muted}" TextWrapping="WrapWholeWords" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Border>
                                <!-- Now playing: the cover large, then the title, the progress and the controls beside it -->
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition x:Name="ArtColumn" Width="92" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="ExpandedArt" Height="92" CornerRadius="14" Background="{StaticResource Line}" VerticalAlignment="Center">
                                        <FontIcon x:Name="ExpandedArtIcon" Glyph="&#xEC4F;" FontSize="26" FontFamily="{StaticResource Icons}" Foreground="{StaticResource Fg}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="TitleText" FontFamily="Segoe UI Variable Display,Segoe UI" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Fg}" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                        <TextBlock x:Name="ArtistText" FontSize="12" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                        <Grid x:Name="ProgressRow" Margin="0,8,0,0" ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="PositionText" FontFamily="{StaticResource Mono}" FontSize="10" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                                            <Grid x:Name="SeekTrack" Grid.Column="1" Height="14" Background="Transparent" Tapped="Seek_Tapped">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition x:Name="SeekDone" Width="0*" />
                                                    <ColumnDefinition x:Name="SeekLeft" Width="1*" />
                                                </Grid.ColumnDefinitions>
                                                <Border x:Name="SeekBack" Grid.ColumnSpan="2" Height="5" CornerRadius="2.5" Background="{StaticResource Line}" />
                                                <Border x:Name="SeekFill" Height="5" CornerRadius="2.5" Background="{StaticResource Ink}" />
                                            </Grid>
                                            <TextBlock x:Name="DurationText" Grid.Column="2" FontFamily="{StaticResource Mono}" FontSize="10" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                                        </Grid>
                                        <Grid Margin="0,4,0,0">
                                            <Grid Width="30" Height="30" CornerRadius="15" Background="Transparent" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                  Tapped="Lyrics_Tapped" PointerEntered="Button_PointerEntered" PointerExited="Button_PointerExited">
                                                <ToolTipService.ToolTip>Synced lyrics</ToolTipService.ToolTip>
                                                <FontIcon x:Name="LyricsIcon" Glyph="&#xE8E4;" FontSize="14" FontFamily="{StaticResource Icons}" Foreground="{StaticResource Muted}" />
                                            </Grid>
                                            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                                                <Grid Width="34" Height="34" CornerRadius="17" Background="Transparent" Tapped="Previous_Tapped"
                                                      PointerEntered="Button_PointerEntered" PointerExited="Button_PointerExited">
                                                    <FontIcon Glyph="&#xE892;" FontSize="15" FontFamily="{StaticResource Icons}" Foreground="{StaticResource Fg}" />
                                                </Grid>
                                                <Grid Width="36" Height="36" CornerRadius="18" Background="{StaticResource Ink}" Tapped="Play_Tapped">
                                                    <FontIcon x:Name="PlayIcon" Glyph="&#xE768;" FontSize="15" FontFamily="{StaticResource Icons}" Foreground="{StaticResource InkText}" />
                                                </Grid>
                                                <Grid Width="34" Height="34" CornerRadius="17" Background="Transparent" Tapped="Next_Tapped"
                                                      PointerEntered="Button_PointerEntered" PointerExited="Button_PointerExited">
                                                    <FontIcon Glyph="&#xE893;" FontSize="15" FontFamily="{StaticResource Icons}" Foreground="{StaticResource Fg}" />
                                                </Grid>
                                            </StackPanel>
                                            <StackPanel x:Name="PanelWave" Margin="0,0,4,0" Orientation="Horizontal" Spacing="2" Height="16" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <Rectangle Width="3" Height="16" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource Ink}" />
                                                <Rectangle Width="3" Height="16" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource Ink}" />
                                                <Rectangle Width="3" Height="16" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource Ink}" />
                                                <Rectangle Width="3" Height="16" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource Ink}" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Grid>

                        <!-- Timers, like the Clock app: durations in capsules; running, a ring that empties around the countdown -->
                        <Grid x:Name="TimersTab" Visibility="Collapsed">
                            <Grid x:Name="TimerIdle" ColumnSpacing="20" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="TIMER" Style="{StaticResource Caps}" />
                                    <TextBlock Text="Pick a length, or focus in rounds" FontSize="12" Foreground="{StaticResource Muted}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Border Style="{StaticResource Capsule}" Tag="60" Tapped="TimerStart_Tapped"><TextBlock Text="1 min" Style="{StaticResource CapsuleText}" /></Border>
                                    <Border Style="{StaticResource Capsule}" Tag="300" Tapped="TimerStart_Tapped"><TextBlock Text="5 min" Style="{StaticResource CapsuleText}" /></Border>
                                    <Border Style="{StaticResource Capsule}" Tag="900" Tapped="TimerStart_Tapped"><TextBlock Text="15 min" Style="{StaticResource CapsuleText}" /></Border>
                                    <Border Style="{StaticResource Capsule}" Tapped="FocusStart_Tapped">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xF5B0;" FontSize="12" FontFamily="{StaticResource Icons}" Foreground="#FF9F0A" />
                                            <TextBlock Text="Focus" Style="{StaticResource CapsuleText}" Foreground="#FF9F0A" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                            <Grid x:Name="TimerRunning" Visibility="Collapsed" ColumnSpacing="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="104" Height="104">
                                    <Ellipse Stroke="{StaticResource Line}" StrokeThickness="6" />
                                    <Ellipse x:Name="TimerArc" StrokeThickness="6" Stroke="#FF9F0A" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform><RotateTransform Angle="-90" /></Ellipse.RenderTransform>
                                    </Ellipse>
                                    <TextBlock x:Name="TimerLeft" FontFamily="{StaticResource Display}" FontSize="24" FontWeight="Light" Foreground="{StaticResource Fg}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="12">
                                    <TextBlock x:Name="TimerLabel" FontFamily="{StaticResource Display}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Fg}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Style="{StaticResource Capsule}" Tapped="TimerAdd_Tapped"><TextBlock Text="+1 min" Style="{StaticResource CapsuleText}" /></Border>
                                        <Border Style="{StaticResource Capsule}" Tapped="TimerCancel_Tapped"><TextBlock Text="Cancel" Style="{StaticResource CapsuleText}" Foreground="#FF453A" /></Border>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <!-- Shelf: files dropped here stay until removed, and drag out into any app -->
                        <StackPanel x:Name="ShelfTab" Visibility="Collapsed" Spacing="6" />

                        <!-- Clipboard -->
                        <StackPanel x:Name="ClipboardTab" Visibility="Collapsed" Spacing="6" />

                        <!-- Coding agents -->
                        <StackPanel x:Name="AgentsTab" Visibility="Collapsed" Spacing="6" />
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
